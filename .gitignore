# Gerado por proposta — nunca versionar
/proposta/
/saida/

# Entradas reais de cliente (os .exemplo ficam versionados)
/entrada/transcricao.md
/entrada/dados-cliente.md
/entrada/observacoes.md
/entrada/*.pdf
/entrada/*.docx
/entrada/*.txt

# Segredos de infraestrutura — o repositório é público
/.env
/.env.*
!/.env.exemplo

# Ruído
__pycache__/
*.pyc
.DS_Store

# Propostas arquivadas — dado de cliente, não pertence ao boilerplate
/arquivo/

# App N1 Propostas — runtime e workspaces (dado de cliente)
/app/dados/
/propostas/
